<Window x:Class="sensorX.Views.GatewayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sensorX.Views"
        mc:Ignorable="d"
        Title=" Gateway" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#08101C"
        Loaded="Window_Loaded">
    <!-- ^ added Loaded event so we check the API as soon as the window opens -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER NAV ================= -->
        <Border Grid.Row="0" Background="#0A1523" Padding="24,18" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="S  E  N  S  O  R - X  " Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <!-- Right Status Section -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- x:Name added here so code-behind (txtApiStatus) can find and update this TextBlock -->
                    <TextBlock x:Name="txtApiStatus" Text="Checking API..." Foreground="#F59E0B" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Firebase Connected" Foreground="#10B981" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Row="1" Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Select an Architectural Pillar" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Choose a  feature to continue." Foreground="#94A3B8" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Cards Grid (3 Columns) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
<Window x:Class="sensorX.Views.SensorAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensor Attachments" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#08101C">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader" Grid.Row="0" FontSize="18" FontWeight="Bold"
                   Foreground="#FFFFFF" Margin="0,0,0,15"/>

        <ListView x:Name="lvAttachments" Grid.Row="1"
                  Background="#0C1623" Foreground="#FFFFFF" BorderBrush="#1E293B"
                  MouseDoubleClick="LvAttachments_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding FileType}"/>
                    <GridViewColumn Header="Uploaded" Width="160" DisplayMemberBinding="{Binding UploadedAt}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="txtCount" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button x:Name="btnBack" Content="Back" Width="90" Height="36"
            Background="#1E293B" Foreground="#FFFFFF" FontWeight="Bold"
            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnBack_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="btnAttach" Content="Attach File" Width="120" Height="36"
            Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold"
            BorderThickness="0" Cursor="Hand" Click="BtnAttach_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
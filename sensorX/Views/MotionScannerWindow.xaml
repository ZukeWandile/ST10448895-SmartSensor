<Window x:Class="sensorX.Views.MotionScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motion Capture Scanner"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#08101C">

    <Window.Resources>
        <!-- CUSTOM DARK SLATE SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0C1623"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#1E293B"
                                                        CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#0EA5E9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel HorizontalAlignment="Left">

                <TextBlock Text="MOTION CAPTURE SCANNER"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="Real-time motion monitoring"
                           FontSize="14"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- BACK BUTTON -->

            <Button x:Name="btnBack"
                    Content="BACK"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="35"
                    Background="#162334"
                    Foreground="#94A3B8"
                    FontWeight="Bold"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="btnBack_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>

            </Button>

        </Grid>


        <!-- SENSOR SELECTION -->

        <Border Grid.Row="1"
                Background="#0C1623"
                Padding="20"
                CornerRadius="8"
                BorderBrush="#1E293B"
                BorderThickness="1"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- LABEL -->

                <TextBlock Grid.Column="0"
                           Text="Motion Sensor:"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>


                <!-- SENSOR DROPDOWN -->

                <ComboBox Grid.Column="1"
                          x:Name="SensorComboBox"
                          DisplayMemberPath="NodeId"
                          SelectionChanged="SensorComboBox_SelectionChanged"
                          Height="35"
                          Background="#162334"
                          Foreground="Black"
                          BorderBrush="#1E293B"
                          BorderThickness="1"/>


                <!-- SENSOR INFORMATION -->

                <TextBlock Grid.Column="2"
                           x:Name="SensorInfoText"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="#64748B"/>

            </Grid>

        </Border>


        <!-- MAIN AREA -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SCANNER AREA -->

            <Border Grid.Column="0"
                    Background="#0C1623"
                    CornerRadius="8"
                    Padding="25"
                    Margin="0,0,15,0"
                    BorderBrush="#1E293B"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- MOTION CANVAS -->

                    <Border Grid.Row="0"
                            Background="#060C15"
                            CornerRadius="6"
                            BorderBrush="#1E293B"
                            BorderThickness="1">

                        <Canvas x:Name="MotionCanvas">


                            <!-- HUMAN FIGURE -->

                            <StackPanel x:Name="HumanFigure"
                                        Canvas.Left="200"
                                        Canvas.Top="100"
                                        Panel.ZIndex="10">

                                <TextBlock Text="●"
                                           FontSize="35"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                                <TextBlock Text="│"
                                           FontSize="40"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                                <TextBlock Text="╱ ╲"
                                           FontSize="35"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                            </StackPanel>


                            <!-- DETECTION MESSAGE -->

                            <TextBlock x:Name="DetectionText"
                                       Text="NO MOVEMENT"
                                       Canvas.Left="175"
                                       Canvas.Top="26"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       Panel.ZIndex="20"/>

                        </Canvas>

                    </Border>


                    <!-- SCANNER CONTROLS -->

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">

                        <WrapPanel>

                            <!-- START SCAN -->

                            <Button x:Name="StartButton"
                                    Content="START SCAN"
                                    Width="140"
                                    Height="40"
                                    Background="#38BDF8"
                                    Foreground="#0F172A"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="StartButton_Click"
                                    Margin="0,0,10,0">

                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>

                            </Button>


                            <!-- STOP SCAN -->

                            <Button x:Name="StopButton"
                                    Content="STOP SCAN"
                                    Width="140"
                                    Height="40"
                                    Background="#162334"
                                    Foreground="#94A3B8"
                                    FontWeight="Bold"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="StopButton_Click"
                                    IsEnabled="False">

                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>

                            </Button>


                            <!-- CLEAR PATH -->

                            <Button x:Name="ClearPathButton"
                                    Content="CLEAR PATH"
                                    Width="140"
                                    Height="40"
                                    Background="#162334"
                                    Foreground="#94A3B8"
                                    FontWeight="Bold"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ClearPathButton_Click"
                                    Margin="10,0,0,0">

                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>

                            </Button>

                            <!-- REPLAY PATH -->

                            <Button x:Name="ReplayPathButton"
                                    Content="REPLAY PATH"
                                    Width="140"
                                    Height="40"
                                    Background="#38BDF8"
                                    Foreground="#0F172A"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ReplayPathButton_Click"
                                    Margin="10,0,0,0">

                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>

                            </Button>

                        </WrapPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- LIVE SENSOR DATA PANEL (SCROLLABLE) -->

            <Border Grid.Column="1"
                    Background="#0C1623"
                    CornerRadius="8"
                    Padding="20"
                    BorderBrush="#1E293B"
                    BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,0,10,0">

                        <!-- TITLE -->

                        <TextBlock Text="LIVE SENSOR DATA"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,20"/>


                        <!-- STATUS -->

                        <TextBlock Text="STATUS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,20">

                            <Ellipse x:Name="StatusIndicator"
                                     Width="10"
                                     Height="10"
                                     Fill="#64748B"
                                     Margin="0,0,8,0"/>

                            <TextBlock x:Name="StatusText"
                                       Text="STOPPED"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"/>

                        </StackPanel>


                        <!-- MOVEMENT -->

                        <TextBlock Text="MOVEMENT"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="MovementText"
                                   Text="--"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,20"/>


                        <!-- CONFIDENCE -->

                        <TextBlock Text="CONFIDENCE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="ConfidenceText"
                                   Text="-- %"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,20"/>


                        <!-- X POSITION -->

                        <TextBlock Text="X POSITION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="XPositionText"
                                   Text="--"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,20"/>


                        <!-- Y POSITION -->

                        <TextBlock Text="Y POSITION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="YPositionText"
                                   Text="--"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,20"/>


                        <!-- MOVEMENT SPEED -->

                        <TextBlock Text="MOVEMENT SPEED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="SpeedText"
                                   Text="-- m/s"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,0,0,20"/>

                        <Separator Margin="0,5,0,20"
                                   Background="#1E293B"/>


                        <!-- SCAN STATISTICS -->

                        <TextBlock Text="SCAN STATISTICS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="SCAN TIME"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="ScanTimeText"
                                   Text="00:00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="DETECTIONS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="DetectionCountText"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="AVERAGE SPEED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="AverageSpeedText"
                                   Text="0.00 m/s"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="MAXIMUM SPEED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="MaximumSpeedText"
                                   Text="0.00 m/s"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="AVERAGE CONFIDENCE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="AverageConfidenceText"
                                   Text="0.0%"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,3,0,20"/>


                        <!-- PATH STATISTICS -->

                        <TextBlock Text="PATH POINTS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="PointCountText"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="DISTANCE TRAVELLED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="DistanceText"
                                   Text="0.00 m"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Window>
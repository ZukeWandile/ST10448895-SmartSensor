<Window x:Class="sensorX.Views.MotionScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motion Capture Scanner"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#08101C">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="MOTION CAPTURE SCANNER"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="Real-time motion monitoring"
                           FontSize="14"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- BACK BUTTON  -->
            <Button x:Name="btnBack"
                    Content="BACK"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="35"
                    Background="#162334"
                    Foreground="#94A3B8"
                    FontWeight="Bold"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="btnBack_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

        </Grid>


        <!-- SENSOR SELECTION -->

        <Border Grid.Row="1"
                Background="#0C1623"
                Padding="20"
                CornerRadius="8"
                BorderBrush="#1E293B"
                BorderThickness="1"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Motion Sensor:"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>


                <ComboBox Grid.Column="1"
                          x:Name="SensorComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SensorComboBox_SelectionChanged"
                          Height="35"
                          Background="#162334"
                          Foreground="Black"
                          BorderBrush="#1E293B"
                          BorderThickness="1"/>


                <TextBlock Grid.Column="2"
                           x:Name="SensorInfoText"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="#64748B"/>

            </Grid>

        </Border>


        <!-- MAIN AREA -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SCANNER AREA -->

            <Border Grid.Column="0"
                    Background="#0C1623"
                    CornerRadius="8"
                    Padding="25"
                    Margin="0,0,15,0"
                    BorderBrush="#1E293B"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Motion Area -->

                    <Border Grid.Row="0"
                            Background="#060C15"
                            CornerRadius="6"
                            BorderBrush="#1E293B"
                            BorderThickness="1">

                        <Canvas x:Name="MotionCanvas">

                            <!-- Human Figure -->

                            <StackPanel x:Name="HumanFigure"
                                        Canvas.Left="200"
                                        Canvas.Top="100">

                                <TextBlock Text="●"
                                           FontSize="35"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>
                                <TextBlock Text="\  /"
                                           FontSize="35"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                                <TextBlock Text="│"
                                           FontSize="40"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                                <TextBlock Text="/ \"
                                           FontSize="35"
                                           HorizontalAlignment="Center"
                                           Foreground="#38BDF8"/>

                            </StackPanel>


                            <TextBlock x:Name="DetectionText"
                                       Text="NO MOVEMENT"
                                       Canvas.Left="175"
                                       Canvas.Top="26"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#64748B"/>

                        </Canvas>

                    </Border>


                    <!-- Controls -->

                    <StackPanel Grid.Row="1"
                                Margin="0,20,0,0">

                        <WrapPanel>

                            <Button x:Name="StartButton"
                                    Content="START SCAN"
                                    Width="140"
                                    Height="40"
                                    Background="#38BDF8"
                                    Foreground="#0F172A"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="StartButton_Click"
                                    Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="StopButton"
                                    Content="STOP SCAN"
                                    Width="140"
                                    Height="40"
                                    Background="#162334"
                                    Foreground="#94A3B8"
                                    FontWeight="Bold"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="StopButton_Click"
                                    IsEnabled="False">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                        </WrapPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- DATA PANEL -->

            <Border Grid.Column="1"
                    Background="#0C1623"
                    CornerRadius="8"
                    Padding="25"
                    BorderBrush="#1E293B"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="LIVE SENSOR DATA"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,20"/>


                    <!-- Status -->

                    <TextBlock Text="STATUS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,20">

                        <Ellipse x:Name="StatusIndicator"
                                 Width="10"
                                 Height="10"
                                 Fill="#64748B"
                                 Margin="0,0,8,0"/>

                        <TextBlock x:Name="StatusText"
                                   Text="STOPPED"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"/>

                    </StackPanel>


                    <!-- Detection -->

                    <TextBlock Text="MOVEMENT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="MovementText"
                               Text="--"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,5,0,20"/>


                    <!-- Confidence -->

                    <TextBlock Text="CONFIDENCE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="ConfidenceText"
                               Text="-- %"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,5,0,20"/>


                    <!-- X -->

                    <TextBlock Text="X POSITION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="XPositionText"
                               Text="--"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,5,0,20"/>


                    <!-- Y -->

                    <TextBlock Text="Y POSITION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="YPositionText"
                               Text="--"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,5,0,20"/>


                    <!-- Speed -->

                    <TextBlock Text="MOVEMENT SPEED"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="SpeedText"
                               Text="-- m/s"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
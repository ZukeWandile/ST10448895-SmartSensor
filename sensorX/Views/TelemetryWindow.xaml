<Window x:Class="sensorX.Views.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Telemetry"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#08101C">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Live Telemetry"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="Real-time sensor monitoring"
                           FontSize="14"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- BACK BUTTON  -->
            <Button x:Name="btnBack"
                    Content="BACK"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="35"
                    Background="#162334"
                    Foreground="#94A3B8"
                    FontWeight="Bold"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="btnBack_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

        </Grid>


        <!-- CURRENT TELEMETRY -->

        <Border Grid.Row="1"
                Background="#0C1623"
                CornerRadius="8"
                Padding="25"
                BorderBrush="#1E293B"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Current header -->

                <Grid Grid.Row="0">

                    <TextBlock Text="CURRENT TELEMETRY"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Ellipse x:Name="StatusIndicator"
                                 Width="10"
                                 Height="10"
                                 Fill="#64748B"
                                 Margin="0,0,8,0"/>

                        <TextBlock x:Name="StatusText"
                                   Text="STOPPED"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"/>

                    </StackPanel>

                </Grid>


                <!-- Values -->

                <Grid Grid.Row="1"
                      Margin="0,20,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <!-- Temperature -->

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="TEMPERATURE"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="TemperatureText"
                                   Text="-- °C"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Power -->

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="POWER"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="PowerText"
                                   Text="-- W"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Valve -->

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="VALVE"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock x:Name="ValveText"
                                   Text="--"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- Controls -->

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">

                    <Button x:Name="StartButton"
                            Content="START TELEMETRY"
                            Width="160"
                            Height="35"
                            Background="#38BDF8"
                            Foreground="#0F172A"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="StartButton_Click"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="StopButton"
                            Content="STOP TELEMETRY"
                            Width="160"
                            Height="35"
                            Background="#162334"
                            Foreground="#94A3B8"
                            FontWeight="Bold"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="StopButton_Click"
                            IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!-- TELEMETRY HISTORY -->

        <Border Grid.Row="3"
                Background="#0C1623"
                CornerRadius="8"
                Padding="25"
                BorderBrush="#1E293B"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="TELEMETRY HISTORY"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>


                <DataGrid Grid.Row="2"
                          x:Name="TelemetryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="Transparent"
                          RowBackground="#0C1623"
                          AlternatingRowBackground="#0F1D2F"
                          Foreground="#FFFFFF"
                          BorderBrush="Transparent"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          HeadersVisibility="Column">

                    <DataGrid.Resources>
                        <!-- Header Styling -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#060C15"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>

                        <!-- Cell Styling -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="TIME"
                                            Binding="{Binding Time}"
                                            Width="*"/>

                        <DataGridTextColumn Header="TEMPERATURE"
                                            Binding="{Binding Temperature}"
                                            Width="*"/>

                        <DataGridTextColumn Header="POWER"
                                            Binding="{Binding Power}"
                                            Width="*"/>

                        <DataGridTextColumn Header="VALVE"
                                            Binding="{Binding Valve}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>
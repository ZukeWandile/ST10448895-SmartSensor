<Window x:Class="sensorX.Views.SensorDashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sensorX.Views"
        mc:Ignorable="d"
        Title="Sensor Dashboard" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#08101C">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation Column -->
            <ColumnDefinition Width="230"/>
            <!-- Main Content Area Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDE NAVIGATION MENU ================= -->
        <Border Grid.Column="0" Background="#060C15" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid Margin="0,20,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand / Application Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,20,30">
                    <Border Width="28" Height="28" Background="#38BDF8" CornerRadius="4">
                        <TextBlock Text="X" Foreground="#0F172A" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <TextBlock Text="S E N S O R - X" Foreground="#F8FAFC" FontWeight="Bold" 
                               FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">

                    <!-- Active Menu Item: Sensor Ingestion -->
                    <Border Background="#102338" BorderBrush="#38BDF8" BorderThickness="2,0,0,0" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="2.5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sensor ingestion" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Menu Item: Live Telemetry -->
                    <Border Background="Transparent" Padding="20,12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Foreground="#94A3B8" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live telemetry" Foreground="#94A3B8" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Menu Item: Motion Scanner -->
                    <Border Background="Transparent" Padding="20,12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌖" Foreground="#94A3B8" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Motion scanner" Foreground="#94A3B8" FontSize="14"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Sign Out Button (Bottom Left Corner) -->
                <Button Grid.Row="2" Content="Sign out" Height="38" Margin="20,0"
                        Background="#1E293B" Foreground="#F8FAFC" 
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ================= MAIN DASHBOARD CONTENT ================= -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard Title Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Sensor Data Ingestion" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Register and monitor connected hardware sensors in real time." Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Workspace Placeholder Card -->
            <Border Grid.Row="1" Background="#0C1623" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="24">
                <TextBlock Text="Ingestion data controls and device table go here..." Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
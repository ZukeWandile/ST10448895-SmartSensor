<Window x:Class="sensorX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sensorX"
        mc:Ignorable="d"
        Title="Sensor"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#06111D">

    <Window.Resources>

        <!-- Main background -->
        <LinearGradientBrush x:Key="BackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#081827" Offset="0"/>
            <GradientStop Color="#0A2033" Offset="0.55"/>
            <GradientStop Color="#06111D" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sign In button gradient -->
        <LinearGradientBrush x:Key="ButtonBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#39A9F5" Offset="0"/>
            <GradientStop Color="#1688D4" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sign In button -->
        <Style x:Key="SignInButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource ButtonBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="26,11"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="0.7"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="233*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- BACKGROUND CIRCLES                                -->
        <!-- ================================================= -->

        <Ellipse Width="650"
                 Height="650"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-260,-300"
                 Stroke="#14364C"
                 StrokeThickness="1"
                 Opacity="0.7" Grid.Column="1"/>

        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-195,-235"
                 Stroke="#19455D"
                 StrokeThickness="1"
                 Opacity="0.65" Grid.Column="1"/>

        <Ellipse Width="390"
                 Height="390"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-130,-170"
                 Stroke="#1C536B"
                 StrokeThickness="1"
                 Opacity="0.5" Grid.Column="1"/>


        <!-- ================================================= -->
        <!-- TOP NAVIGATION                                    -->
        <!-- ================================================= -->

        <Grid Height="80"
              VerticalAlignment="Top"
              Margin="20,0,55,0" Grid.Column="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- SENTINEL LOGO -->

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Grid Width="42"
                      Height="42"
                      Margin="0,0,14,0">

                    <!-- Hexagon -->
                    <Polygon Points="21,1 40,11 40,31 21,41 2,31 2,11"
                             Fill="#2399E8"/>

                    <!-- S -->
                    <TextBlock Text="X"
                               Foreground="#06111D"
                               FontSize="21"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>


                <TextBlock Text="Sensor X"
                           Foreground="#F2F7FC"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </StackPanel>


            <!-- SIGN IN BUTTON -->

            <Button Grid.Column="1"
                    Content="Sign In"
                    Style="{StaticResource SignInButton}"
                    Click="SignInButton_Click"
                    VerticalAlignment="Center"/>

        </Grid>


        <!-- ================================================= -->
        <!-- MAIN CONTENT                                      -->
        <!-- ================================================= -->

        <Grid Margin="65,120,100,70" Grid.Column="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.1*"/>

                <ColumnDefinition Width="0.9*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT SIDE                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        MaxWidth="650">





                <!-- MAIN HEADING -->

                <TextBlock Foreground="#E9F4FF"
                           FontSize="54"
                           FontWeight="Bold"
                           LineHeight="62"
                           TextWrapping="Wrap">

                    <Run Text="Observe every"/>

                    <LineBreak/>

                    <Run Text="movement. Secure"/>

                    <LineBreak/>

                    <Run Text="every space."/>

                </TextBlock>


                <!-- DESCRIPTION -->




                <!-- FEATURES -->

                <StackPanel Orientation="Horizontal">


                    <!-- LIVE SENSOR DATA -->

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,35,0">



                    </StackPanel>


                    <!-- MOTION CAPTURE -->



                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- RIGHT SENSOR VISUALIZATION                         -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Width="420"
                  Height="420">


                <!-- OUTER RING -->

                <Ellipse Width="360"
                         Height="360"
                         Stroke="#173D54"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>


                <!-- MIDDLE RING -->

                <Ellipse Width="270"
                         Height="270"
                         Stroke="#1A4C63"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>


                <!-- INNER RING -->

                <Ellipse Width="175"
                         Height="175"
                         Stroke="#1D637B"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>


                <!-- CENTER SENSOR -->

                <Ellipse Width="90"
                         Height="90"
                         Fill="#0B2A3D"
                         Stroke="#29B7E9"
                         StrokeThickness="2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>


                <!-- SENSOR DOT -->

                <Ellipse Width="18"
                         Height="18"
                         Fill="#36E4E6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>


                <!-- SCAN LINE -->

                <Line X1="210"
                      Y1="210"
                      X2="390"
                      Y2="105"
                      Stroke="#27C7E8"
                      StrokeThickness="1"
                      Opacity="0.8"/>


                <!-- DATA POINT 1 -->

                <Ellipse Width="8"
                         Height="8"
                         Fill="#36E4E6"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="70,100,0,0"/>


                <!-- DATA POINT 2 -->

                <Ellipse Width="7"
                         Height="7"
                         Fill="#36E4E6"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="65,0,0,100"/>


                <!-- DATA POINT 3 -->

                <Ellipse Width="6"
                         Height="6"
                         Fill="#39E89B"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="100,80,0,0"/>


                <!-- SENSOR STATUS -->

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20">

                    <TextBlock Text="SENSOR NETWORK"
                               Foreground="#5E91AE"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ONLINE"
                               Foreground="#39E89B"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Grid>


        <!-- ================================================= -->
        <!-- BOTTOM STATUS BAR                                 -->
        <!-- ================================================= -->

        <Grid Height="45"
              VerticalAlignment="Bottom"
              Margin="20,0,55,0" Grid.Column="1">





            <TextBlock Text="SYSTEM READY"
                       Foreground="#39E89B"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>